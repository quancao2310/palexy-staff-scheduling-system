# Copy to `.env` to override the defaults used by compose.yaml. Every variable is optional.
# `.env` is gitignored; never commit real credentials.

# Port the app is published on (http://localhost:${APP_PORT})
APP_PORT=8080

# PostgreSQL credentials. The same values are passed to the backend as DB_URL / DB_USER / DB_PASSWORD.
POSTGRES_DB=scheduler
POSTGRES_USER=scheduler
POSTGRES_PASSWORD=scheduler

# Host port for Postgres when using compose.dev.yaml (bound to 127.0.0.1 only)
DB_PORT=5432
